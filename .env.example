VERSION=1.0.0
SERVICE_NAME=ffgif
ADDR=127.0.0.1
PORT=8080
APP_BASE_URL=http://127.0.0.1:8080

JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long_example
HASH_PEPPER=your_hash_pepper_must_be_at_least_32_characters_long_example
BCRYPT_COST=12

PG_USER=ffgif
PG_PASSWORD=change_this_password
PG_PORT=5432
PG_ADDRESS=localhost
PG_NAME=ffgif
PG_SSLMODE=disable

PG_SUPERUSER=postgres
PG_SUPERDB=postgres

DATABASE_URL=postgresql://ffgif:change_this_password@localhost:5432/ffgif?sslmode=disable

REDIS_ADDR=localhost:6379

EMAIL=noreply@example.com

MINIO_ADDR=127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_TEMP_BUCKET=uploads
MINIO_PERSIST_BUCKET=storage
MINIO_TEMP_BUCKET_TTL_DAYS=1
MINIO_API_CORS_ALLOW_ORIGIN=http://0.0.0.0:8080,http://localhost:8080,http://127.0.0.1:8080
MINIO_NOTIFY_EXCHANGE=notify.upload.exchange
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
CORS_ORIGINS=http://0.0.0.0:8080,http://localhost:8080,http://127.0.0.1:8080

RMQ_ADDR=localhost:5672
RMQ_USER=guest
RMQ_PASS=guest

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=your_smtp_password_here